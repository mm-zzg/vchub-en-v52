{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Start and watch for changes",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "beginsPattern": "material\/templates",
          "endsPattern": "."
        }
      }
    },
    {
      "label": "Preview docs: on-premise",
      "type": "shell",
      "command": "mkdocs serve --dirtyreload --dev-addr 127.0.0.1:8000",
      "isBackground": true,
      "options": {
        "env": {
          "DOCS_BUILD_MODE": "on-premise"
        }
      },
      "presentation": {
        "group": "docs-preview",
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview docs: SaaS",
      "type": "shell",
      "command": "mkdocs serve --dirtyreload --dev-addr 127.0.0.1:8001",
      "isBackground": true,
      "options": {
        "env": {
          "DOCS_BUILD_MODE": "saas"
        }
      },
      "presentation": {
        "group": "docs-preview",
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Preview docs: both modes",
      "dependsOn": [
        "Preview docs: on-premise",
        "Preview docs: SaaS"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
